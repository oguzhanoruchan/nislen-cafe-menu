rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.token.email_verified == true;
    }
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.token.email_verified == true;
    }
  }
}
